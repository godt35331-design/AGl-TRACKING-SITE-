# Copy these into your hosting environment (Render -> Environment). Never commit real values.

# Database
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/agl_portal

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=AGL Support <support@aglgloballogistics.com>

# --- Security (required) ---
# The secret the administrator types on the Track Shipment screen to open the admin dashboard.
# Choose 16+ random characters. Administrator sign-in is disabled until this is set.
ADMIN_TRACKING_CODE=
# Signs login sessions. 32+ random characters. If it is missing, everyone is signed out on every restart.
AUTH_SECRET=
# Optional: address shown for the administrator account.
ADMIN_EMAIL=admin@aglgloballogistics.com
# Optional: if set, the inbound-email webhook must send this value (header x-webhook-secret or ?secret=).
INBOUND_WEBHOOK_SECRET=
